# Desenvolvimento local. Copie para .env e exporte as variáveis (ou use `node --env-file=.env server.js`).
# Em produção (NODE_ENV=production) ADMIN_PASSWORD e JWT_SECRET são OBRIGATÓRIOS.
PORT=3000
# NODE_ENV=production
ADMIN_PASSWORD=
JWT_SECRET=

AWS_REGION=us-east-1
# DynamoDB (auditoria): sem DYNAMODB_TABLE_NAME a auditoria fica só em memória.
# Na AWS real defina também AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN no Academy).
DYNAMODB_TABLE_NAME=
# DYNAMODB_ENDPOINT=http://localhost:8000  (DynamoDB Local; deixe vazio para a AWS)

# Use os mesmos valores do .env da raiz (POSTGRES_USER/PASSWORD/DB)
DATABASE_URL=postgresql://postgres:troque-esta-senha@localhost:5432/stadiumdb
RABBITMQ_URL=amqp://stadium:troque-a-senha-do-rabbitmq@localhost:5672
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=stadium-files
MINIO_ACCESS_KEY=stadium
MINIO_SECRET_KEY=troque-a-senha-do-minio
REDIS_URL=redis://localhost:6379
