# Desenvolvimento local. Copie para .env e exporte as variáveis (ou use `node --env-file=.env server.js`).
# Em produção (NODE_ENV=production) ADMIN_PASSWORD e JWT_SECRET são OBRIGATÓRIOS.
PORT=3000
# NODE_ENV=production
ADMIN_PASSWORD=
JWT_SECRET=

AWS_REGION=us-east-1
# Na EC2 as credenciais vêm da IAM Role: NÃO defina AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY lá.
# Recursos AWS ficam desligados (modo local) enquanto a variável estiver vazia/ausente.
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

# Use os mesmos valores do .env da raiz (POSTGRES_USER/PASSWORD/DB)
DATABASE_URL=postgresql://postgres:troque-esta-senha@localhost:5432/stadiumdb
RABBITMQ_URL=amqp://stadium:troque-a-senha-do-rabbitmq@localhost:5672
REDIS_URL=redis://localhost:6379
