# Copie para .env (cp .env.example .env) e troque os valores antes de subir: docker compose up --build -d

# PostgreSQL (container "postgres")
POSTGRES_USER=postgres
POSTGRES_PASSWORD="senha1234"
POSTGRES_DB=stadiumdb

# RabbitMQ (container "rabbitmq"). Evite @ : / # % na senha (ela vai dentro da URL amqp://)
RABBITMQ_USER=stadium
RABBITMQ_PASSWORD=troque-a-senha-do-rabbitmq

# MinIO (container "minio"): a senha precisa ter pelo menos 8 caracteres
MINIO_ROOT_USER=stadium
MINIO_ROOT_PASSWORD=troque-a-senha-do-minio
MINIO_BUCKET=stadium-files

# Segredos da aplicação (obrigatórios com NODE_ENV=production, que é o que a imagem usa)
ADMIN_PASSWORD="admin1234"
JWT_SECRET="JWT_SECRET_NUVEM_1234_4321_!@#$_()%%%%%%%_PASSWORD"

PORT=3000
